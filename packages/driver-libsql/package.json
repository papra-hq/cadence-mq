{
  "name": "@cadence-mq/driver-libsql",
  "version": "0.2.4",
  "description": "LibSQL driver for CadenceMQ",
  "keywords": [
    "cadence",
    "cadence-mq",
    "job-queue",
    "libsql",
    "sqlite",
    "task-queue"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "pnpm build:watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@cadence-mq/core": "workspace:*",
    "@types/node": "^26.4.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@cadence-mq/core": "workspace:^0.2.3"
  },
  "engines": {
    "node": ">=26"
  }
}
