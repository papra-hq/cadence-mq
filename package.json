{
  "name": "@cadence-mq/root",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages:watch",
    "build:packages": "pnpm -r --parallel -F './packages/*' build",
    "build:packages:watch": "pnpm -r --parallel -F './packages/*' build:watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "oxlint && oxfmt --check",
    "check:quiet": "oxlint --quiet && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
